# PostgreSQL + Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropbox_tag_kanban?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_32_plus_char_random_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dropbox placeholders (for future integration)
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
DROPBOX_SOURCE_FOLDER=/incoming
DROPBOX_TARGET_MODE=metadata
